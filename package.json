{
  "name": "evoveo-smart-reporter",
  "version": "2.1.0",
  "description": "An intelligent test reporter with AI-powered failure analysis, flakiness detection, and performance regression alerts. Works with Playwright, Cypress, Selenium, Jest, Vitest, Pytest, MSTest/TRX, Postman/Newman, SoapUI, and more.",
  "main": "dist/smart-reporter.js",
  "types": "dist/smart-reporter.d.ts",
  "bin": {
    "evoveo-smart-reporter-merge-history": "./dist/bin/merge-history.js",
    "evoveo-smart-reporter-view-trace": "./dist/bin/view-trace.js",
    "evoveo-smart-reporter-serve": "./dist/bin/serve.js",
    "evoveo-smart-reporter": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/smart-reporter.d.ts",
      "default": "./dist/smart-reporter.js"
    },
    "./quarantine": {
      "types": "./dist/quarantine/quarantine-helper.d.ts",
      "default": "./dist/quarantine/quarantine-helper.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./report-generator": {
      "types": "./dist/report-generator.d.ts",
      "default": "./dist/report-generator.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "examples": "node scripts/generate-examples.js",
    "test:demo": "playwright test --config=example/playwright.config.ts",
    "test:merge-local": "rm -rf blob-reports && mkdir -p blob-reports/all && PLAYWRIGHT_BLOB_OUTPUT_DIR=blob-reports/run1 playwright test example/parallel/test1.spec.ts --config=example/playwright-blob.config.ts; PLAYWRIGHT_BLOB_OUTPUT_DIR=blob-reports/run2 playwright test example/parallel/test2.spec.ts --config=example/playwright-blob.config.ts; cp blob-reports/run1/*.zip blob-reports/run2/*.zip blob-reports/all/; node ./dist/merge-history.js blob-reports/run1/test-history.json blob-reports/run2/test-history.json -o blob-reports/all/test-history.json; npx playwright merge-reports --reporter=./dist/smart-reporter.js blob-reports/all"
  },
  "keywords": [
    "playwright",
    "reporter",
    "testing",
    "html-reporter",
    "ai",
    "flaky-tests",
    "performance",
    "test-analysis",
    "test-stability",
    "retry-analysis",
    "failure-clustering",
    "trace-viewer",
    "quality-gates",
    "pdf-export",
    "test-quarantine",
    "ci-cd",
    "junit",
    "trx",
    "mstest",
    "cypress",
    "selenium",
    "newman",
    "postman",
    "soapui",
    "jest",
    "vitest",
    "pytest",
    "restsharp"
  ],
  "author": "Evoveo Tech",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/evoveotech/testreport-forge.git"
  },
  "homepage": "https://github.com/evoveotech/testreport-forge#readme",
  "bugs": {
    "url": "https://github.com/evoveotech/testreport-forge/issues"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/adm-zip": "^0.5.7",
    "@types/pdfkit": "^0.13.8",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "pdfkit": "^0.16.0"
  }
}
